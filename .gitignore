cd ~/GitHub/6-tap-fir-filter-asic

cat > .gitignore <<'EOF'
# Logs and temporary files
*.log
*.tmp
*.bak
*.jou

# Vivado
*.wdb
*.str
*.cache/
*.runs/
*.sim/
*.hw/
*.ip_user_files/

# OpenLane intermediate files
runs/*/tmp/
runs/*/logs/
runs/*/objects/

# Python
__pycache__/
*.pyc

# Editors
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
EOF
